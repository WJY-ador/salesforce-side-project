<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>

    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property
                name="cardTitle"
                type="String"
                label="카드 제목"
                default="계정 요약 (Account Summary)" />
            <property
                name="industryGroup"
                type="String"
                label="산업군"
                default="상급종합병원" />
            <property
                name="companySize"
                type="String"
                label="규모"
                default="1,000병상 이상" />
            <property
                name="statusLabel"
                type="String"
                label="현재 상태"
                default="Active" />
        </targetConfig>

        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
            </objects>
            <property
                name="cardTitle"
                type="String"
                label="카드 제목"
                default="계정 요약 (Account Summary)" />
            <property
                name="industryGroup"
                type="String"
                label="산업군"
                default="상급종합병원" />
            <property
                name="companySize"
                type="String"
                label="규모"
                default="1,000병상 이상" />
            <property
                name="statusLabel"
                type="String"
                label="현재 상태"
                default="Active" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>